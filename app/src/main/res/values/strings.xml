    <string name="app_name">Vector Flasher</string>

    <!-- Guide -->
    <string name="guide_title">Get Vector ready</string>
    <string name="guide_subtitle">Four steps. No account needed.</string>
    <string name="guide_step1_title">Turn Vector on</string>
    <string name="guide_step1_body">Put him on the charger and power him up. He has to stay on the charger for the whole process.</string>
    <string name="guide_step2_title">Hold the power button</string>
    <string name="guide_step2_body">Hold the power button until the lights on his back go out completely, then let go the moment they come back on. You should land on a screen showing:</string>
    <string name="guide_step3_title">Double-press the back button</string>
    <string name="guide_step3_body">Press it twice and wait until his face reads Vector-(ID) with a few hashes underneath:</string>
    <string name="guide_step4_title">Press your Vector</string>
    <string name="guide_step4_body">Six numbers appear on his face. Type them into the app and you are paired.</string>
    <string name="guide_start">Start</string>
    <string name="guide_skip">Skip</string>
