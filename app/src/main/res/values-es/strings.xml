    <string name="app_name">Vector Flasher</string>

    <!-- Guía -->
    <string name="guide_title">Prepara a Vector</string>
    <string name="guide_subtitle">Cuatro pasos. Sin crear cuenta.</string>
    <string name="guide_step1_title">Enciende a Vector</string>
    <string name="guide_step1_body">Ponlo en el cargador y enciéndelo. Tiene que quedarse en el cargador todo el proceso.</string>
    <string name="guide_step2_title">Mantén presionado el botón de encendido</string>
    <string name="guide_step2_body">Déjalo presionado hasta que las luces de atrás se apaguen por completo, y suéltalo justo cuando se vuelvan a prender. Deberías quedar en una pantalla que dice:</string>
    <string name="guide_step3_title">Presiona dos veces el botón de la espalda</string>
    <string name="guide_step3_body">Dos toques, y espera a que en la cara diga Vector-(ID) con unos hashtags abajo:</string>
    <string name="guide_step4_title">Presiona tu Vector</string>
    <string name="guide_step4_body">Aparecerán 6 números en su cara. Escríbelos en la app y ya está emparejado.</string>
    <string name="guide_start">Empezar</string>
    <string name="guide_skip">Saltar</string>
    <string name="guide_again">Ver los pasos otra vez</string>

